# Copy to .env. Pick ONE model line; change it to swap models.
# Format: provider:model-name (any PydanticAI provider works).

# Local, free, no key (default): needs Ollama running.
MODEL=ollama:qwen2.5:7b-instruct
# MODEL=ollama:qwen3:4b-instruct          # too small: often skips the answer tool
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Free cloud tiers (each needs its key below; some need an extra package):
# MODEL=openrouter:<model-name>:free     # no extra package
# MODEL=cerebras:<model-name>            # no extra package
# MODEL=groq:<model-name>                # uv pip install "pydantic-ai-slim[groq]"
# MODEL=google:<model-name>              # uv pip install "pydantic-ai-slim[google]"

# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
